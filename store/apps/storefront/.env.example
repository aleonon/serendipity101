NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_DEFAULT_REGION=ec
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Browser-safe payment key. Leave empty until a production provider is chosen.
# Never put a secret key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_PAYMENT_PUBLISHABLE_KEY=

# Unused while Stripe is not the selected provider. Publishable only.
NEXT_PUBLIC_STRIPE_KEY=
