STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DB_NAME=medusa-backend

# Production: set STORE_CORS, ADMIN_CORS, and AUTH_CORS to the live origins.
# JWT_SECRET and COOKIE_SECRET must be unique random values, never placeholders.

# Payments. Development uses Medusa's manual provider. Leave the provider
# empty until one is chosen. Never commit real secrets.
# test | live
SERENDIPITY_PAYMENT_MODE=test
SERENDIPITY_PAYMENT_PROVIDER=
SERENDIPITY_PAYMENT_TEST_SECRET_KEY=
SERENDIPITY_PAYMENT_TEST_WEBHOOK_SECRET=
SERENDIPITY_PAYMENT_LIVE_SECRET_KEY=
SERENDIPITY_PAYMENT_LIVE_WEBHOOK_SECRET=
